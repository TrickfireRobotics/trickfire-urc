# syntax=docker/dockerfile:1
# ARM64 rover environment; requires a hardware-validated base and matching ZED SDK.
# Application workspaces are bind-mounted at /trickfire-urc, not baked into this image.
ARG ROVER_BASE_IMAGE=rover-base-unset--pending-zed-sdk-hardware-validation
FROM ${ROVER_BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_APT_SOURCE_VERSION=1.2.0
ARG ZED_SDK_URL=""
ARG ZED_WRAPPER_TAG=v5.4.1

RUN test -n "${ZED_SDK_URL}" || { \
      echo "ERROR: ZED_SDK_URL build arg is required." >&2; exit 1; \
    }

# Add the ROS repository to the hardware base.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    curl -fsSL -o /tmp/ros2-apt-source.deb \
      "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${VERSION_CODENAME})_all.deb" && \
    apt-get install -y --no-install-recommends /tmp/ros2-apt-source.deb && \
    rm -f /tmp/ros2-apt-source.deb && \
    rm -rf /var/lib/apt/lists/*

# Common ROS dependencies (also in Dockerfile.dev), plus ZED installer prerequisites.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      lsb-release \
      python3-colcon-common-extensions \
      python3-numpy \
      python3-opencv \
      python3-pip \
      python3-rosdep \
      ros-jazzy-coal \
      ros-jazzy-cv-bridge \
      ros-jazzy-pinocchio \
      ros-jazzy-ros-base \
      ros-jazzy-rosbridge-server \
      sudo \
      udev \
      zstd \
    && rm -rf /var/lib/apt/lists/*

# Install the ZED SDK runtime.
RUN curl -fsSL -o /tmp/zed_sdk.run "${ZED_SDK_URL}" && \
    chmod +x /tmp/zed_sdk.run && \
    /tmp/zed_sdk.run -- silent runtime_only && \
    rm -f /tmp/zed_sdk.run

# Build the pinned ZED ROS wrapper as an underlay.
RUN git clone --branch "${ZED_WRAPPER_TAG}" --depth 1 --recurse-submodules \
      https://github.com/stereolabs/zed-ros2-wrapper.git \
      /opt/zed_ws/src/zed-ros2-wrapper && \
    apt-get update && \
    (rosdep init 2>/dev/null || true) && \
    rosdep update && \
    rosdep install --from-paths /opt/zed_ws/src --ignore-src -y --rosdistro jazzy && \
    . /opt/ros/jazzy/setup.sh && \
    cd /opt/zed_ws && \
    colcon build --parallel-workers "$(nproc)" \
      --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    rm -rf /opt/zed_ws/build /opt/zed_ws/log /var/lib/apt/lists/*

COPY --chmod=755 <<'ENTRYPOINT' /usr/local/bin/rover-entrypoint.sh
#!/usr/bin/env bash
set -e
source /opt/ros/jazzy/setup.bash
source /opt/zed_ws/install/setup.bash
for ws in /trickfire-urc/src-autonomy /trickfire-urc/src-platform; do
    if [ -f "${ws}/install/setup.bash" ]; then
        source "${ws}/install/setup.bash"
    fi
done
exec "$@"
ENTRYPOINT
ENTRYPOINT ["/usr/local/bin/rover-entrypoint.sh"]
CMD ["bash"]
